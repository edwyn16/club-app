// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClubType {
  ADVENTURER
  PATHFINDER
}

enum ClubRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum ClubYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model Church {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  clubs                Club[]
  registrationRequests ClubRegistrationRequest[]

  @@map("churches")
}

model Club {
  id   String   @id @default(uuid()) @db.Uuid
  name String
  type ClubType

  churchId String @map("church_id") @db.Uuid
  church   Church @relation(fields: [churchId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  subscriptions ClubSubscription[]
  settings      ClubSettings?
  years         ClubYear[]
  userRoles     UserClubRole[]
  staffProfiles StaffProfile[]

  @@index([churchId])
  @@map("clubs")
}

model ClubRegistrationRequest {
  id String @id @default(uuid()) @db.Uuid

  proposedClubName String   @map("proposed_club_name")
  clubType         ClubType @map("club_type")

  applicantName  String @map("applicant_name")
  applicantEmail String @map("applicant_email")

  churchId String? @map("church_id") @db.Uuid
  church   Church? @relation(fields: [churchId], references: [id])

  proposedChurchName String? @map("proposed_church_name")

  status ClubRegistrationStatus @default(PENDING)

  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote String?   @map("review_note")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([churchId])
  @@index([status])
  @@map("club_registration_requests")
}

model ClubSubscription {
  id String @id @default(uuid()) @db.Uuid

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id])

  status ClubSubscriptionStatus @default(PENDING)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([clubId])
  @@index([status])
  @@map("club_subscriptions")
}

model ClubSettings {
  id String @id @default(uuid()) @db.Uuid

  clubId String @unique @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id])

  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  logoUrl String? @map("logo_url")

  notificationsEnabled Boolean @default(true) @map("notifications_enabled")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("club_settings")
}

model ClubYear {
  id String @id @default(uuid()) @db.Uuid

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id])

  name String

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  status ClubYearStatus @default(PLANNED)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([clubId, name])
  @@index([clubId, status])
  @@map("club_years")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique
  passwordHash String @map("password_hash")
  firstName    String @map("first_name")
  lastName     String @map("last_name")

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  clubRoles     UserClubRole[]
  platformRoles UserPlatformRole[]
  staffProfiles StaffProfile[]
  authSessions  AuthSession[]

  @@map("users")
}

enum RoleScope {
  PLATFORM
  CLUB
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  code        String    @unique
  name        String
  description String?
  scope       RoleScope

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  rolePermissions   RolePermission[]
  userClubRoles     UserClubRole[]
  userPlatformRoles UserPlatformRole[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique
  name        String
  description String?
  domain      String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([domain])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserClubRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id])

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, clubId])
  @@index([clubId, roleId])
  @@map("user_club_roles")
}

model UserPlatformRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([roleId])
  @@map("user_platform_roles")
}

model StaffProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  clubId String @map("club_id") @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([clubId])
  @@map("staff_profiles")
}

model AuthSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
